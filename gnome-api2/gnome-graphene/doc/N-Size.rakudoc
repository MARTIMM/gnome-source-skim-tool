#-------------------------------------------------------------------------------
#--[Record Structure Documentation]---------------------------------------------
#-------------------------------------------------------------------------------

=begin rakudoc
=head1 Record N-Size

  class N-Size:auth<github:MARTIMM>:api<2> is export is repr('CStruct') {

    has gfloat $.width;
    has gfloat $.height;
  }

=item width; the width
=item height; the height

=end rakudoc

