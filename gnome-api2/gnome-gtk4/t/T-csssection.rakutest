subtest 'ISA test', {
  given $t-csssection {
    my N-Object() $file;
    my N-Object $bytes;
    my N-Object $start;
    my N-Object $end;

#`{{
    #TC:0:new-csssection()
    $file = …;
    $start = …;
    $end = …;
    $t-csssection .= new-csssection( $file, $start, $end);
    ok .is-valid, '.new-csssection( $file, $start, $end)';

    #TC:0:new-with-bytes()
    $file = …;
    $bytes = …;
    $start = …;
    $end = …;
    $t-csssection .= new-with-bytes( $file, $bytes, $start, $end);
    ok .is-valid, '.new-with-bytes( $file, $bytes, $start, $end)';

}}
  }
};

