use Gnome::Gdk4::Display:api<2>;

use Gnome::N::GlibToRakuTypes:api<2>;
use Gnome::N::N-Object:api<2>;
use Gnome::N::NativeLib:api<2>;
use Gnome::N::X:api<2>;

#-------------------------------------------------------------------------------
#--[Test preparation]-----------------------------------------------------------
#-------------------------------------------------------------------------------

#Gnome::N::debug(:on);
my Gnome::Gtk4::ShortcutTrigger $shortcuttrigger1;
my Gnome::Gtk4::ShortcutTrigger $shortcuttrigger2;
#my Gnome::Gtk4::AlternativeTrigger $trigger3;
#$trigger3 .= parse-string('<CTRL>z|<ALT>z');
#note .compare($trigger3);

#-------------------------------------------------------------------------------
#--[Class init tests]-----------------------------------------------------------
#-------------------------------------------------------------------------------

subtest 'ISA test', {
  given $shortcuttrigger1 {
    my Str $string = 'F6';

    #TM:1:parse-string()
    ok .parse-string($string).is-valid, '.parse-string()';

#`{{
}}
  }
};

#-------------------------------------------------------------------------------
#-------------------------------------------------------------------------------
#-------------------------------------------------------------------------------
# set environment variable 'raku-test-all' if rest must be tested too.
unless %*ENV<raku_test_all>:exists {
  done-testing;
  exit;
}

#-------------------------------------------------------------------------------
subtest 'Method tests', {
  $shortcuttrigger1 .= parse-string('<CTRL>F5');
  $shortcuttrigger2 .= parse-string('<CTRL>z');

  with $shortcuttrigger1 {
    my Gnome::Gtk4::Window $window .= new-window;
    my Gnome::Gdk4::Display() $display = $window.get-display;
#    my N-Object $string;
#    my N-Object() $event;
    my Int $v;
    my Str $s;

    #TM:1:compare()
    lives-ok {
      $v = .compare($shortcuttrigger2);
      diag ".compare() returns $v";
    }, ".compare()";


    #TM:1:equal()
    ok !.equal($shortcuttrigger2), '.equal()';

    #TM:1:hash()
    lives-ok {
      $v = .hash();
      diag ".hash() returns $v";
    }, '.hash()';

#`{{
    #TM:0:print()
    ok .print($string), '.print()';
}}

#`{{
    #TM:0:print-label()
    ok .print-label( $display, $string), '.print-label()';
}}

    #TM:1:to-label()
    lives-ok {
      $s = .to-label($display);
      diag ".to-label() returns $s";
    }, '.to-label()';

    #TM:1:to-string()
    lives-ok {
      $s = .to-string();
      diag ".to-string() returns $s";
    }, '.to-string()';

#`{{
    #TM:0:trigger()
    lives-ok {
      my $v = .trigger( $event, False), '.trigger()';
}}
  }
};

#-------------------------------------------------------------------------------
done-testing;

=finish

#-------------------------------------------------------------------------------
subtest 'Signals …', {
  use Gnome::Gtk3::Main;

  my Gnome::Gtk3::Main $main .= new;

  class SignalHandlers {
    has Bool $!signal-processed = False;

    method … (
      'any-args',
      Gnome::Gtk4::ShortcutTrigger() :$_native-object, gulong :$_handler-id
      # --> …
    ) {

      isa-ok $_native-object, Gnome::Gtk4::ShortcutTrigger;
      $!signal-processed = True;
    }

    method signal-emitter ( Gnome::Gtk4::ShortcutTrigger :$_widget --> Str ) {

      while $main.gtk-events-pending() { $main.iteration-do(False); }

      $_widget.emit-by-name(
        'signal',
      #  'any-args',
      #  :return-type(int32),
      #  :parameters([int32,])
      );
      is $!signal-processed, True, ''…' signal processed';

      while $main.gtk-events-pending() { $main.iteration-do(False); }

      #$!signal-processed = False;
      #$_widget.emit-by-name(
      #  'signal',
      #  'any-args',
      #  :return-type(int32),
      #  :parameters([int32,])
      #);
      #is $!signal-processed, True, ''…' signal processed';

      while $main.gtk-events-pending() { $main.iteration-do(False); }
      sleep(0.4);
      $main.gtk-main-quit;

      'done'
    }
  }

  my Gnome::Gtk4::ShortcutTrigger $shortcuttrigger .= new;

  #my Gnome::Gtk3::Window $w .= new;
  #$w.add($m);

  my SignalHandlers $sh .= new;
  $shortcuttrigger.register-signal( $sh, 'method', 'signal');

  my Promise $p = $i.start-thread(
    $sh, 'signal-emitter',
    # :!new-context,
    # :start-time(now + 1)
  );

  is $main.gtk-main-level, 0, "loop level 0";
  $main.gtk-main;
  #is $main.gtk-main-level, 0, "loop level is 0 again";

  is $p.result, 'done', 'emitter finished';
}

