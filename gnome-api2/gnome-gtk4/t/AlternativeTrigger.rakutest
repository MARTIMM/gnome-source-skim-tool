use Gnome::N::NativeLib:api<2>;
use Gnome::N::X:api<2>;

#-------------------------------------------------------------------------------
#--[Test preparation]-----------------------------------------------------------
#-------------------------------------------------------------------------------

#Gnome::N::debug(:on);
my Gnome::Gtk4::AlternativeTrigger $alternativetrigger;
#my Gnome::Gtk4::ShortcutTrigger $shortcuttrigger1;
#my Gnome::Gtk4::ShortcutTrigger $shortcuttrigger1;

#-------------------------------------------------------------------------------
#--[Class init tests]-----------------------------------------------------------
#-------------------------------------------------------------------------------

subtest 'ISA test', {
  my Gnome::Gtk4::ShortcutTrigger $first .= parse-string('<CTRL>F5');
  my Gnome::Gtk4::ShortcutTrigger $second .= parse-string('<ALT>A');

  #TC:1:new-alternativetrigger()
  $alternativetrigger .= parse-string('<CTRL>F5|<SHIFT>8');
  ok $alternativetrigger.is-valid,
    '$alternativetrigger = $first.parse-string("<CTRL>F5|<SHIFT>8");';

  $alternativetrigger .= new-alternativetrigger( $first, $second);
  ok $alternativetrigger.is-valid,
    ".new-alternativetrigger( '$first.to-string()', '$second.to-string()')";
};

#-------------------------------------------------------------------------------
#-------------------------------------------------------------------------------
#-------------------------------------------------------------------------------
# set environment variable 'raku-test-all' if rest must be tested too.
unless %*ENV<raku_test_all>:exists {
  done-testing;
  exit;
}

#-------------------------------------------------------------------------------
subtest 'Method tests', {
  with $alternativetrigger {
    my Gnome::Gtk4::ShortcutTrigger() $trigger;
    
    #TM:1:get-first()
    $trigger = .get-first;
    my Str $s = $trigger.to-string;
    is $s, '<Control>F5', '.get-first() returns <Control>F5';

    #TM:1:get-second()
    $trigger = .get-second;
    $s = $trigger.to-string;
    is $s, '<Alt>a', '.get-second() returns <Alt>a';

#`{{
}}
  }
};

#-------------------------------------------------------------------------------
subtest 'Function tests', {
  with $alternativetrigger {


#`{{
}}
  }
};

#-------------------------------------------------------------------------------
done-testing;

=finish

#-------------------------------------------------------------------------------
subtest 'Signals …', {
  use Gnome::Gtk3::Main;

  my Gnome::Gtk3::Main $main .= new;

  class SignalHandlers {
    has Bool $!signal-processed = False;

    method … (
      'any-args',
      Gnome::Gtk4::AlternativeTrigger() :$_native-object, gulong :$_handler-id
      # --> …
    ) {

      isa-ok $_native-object, Gnome::Gtk4::AlternativeTrigger;
      $!signal-processed = True;
    }

    method signal-emitter ( Gnome::Gtk4::AlternativeTrigger :$_widget --> Str ) {

      while $main.gtk-events-pending() { $main.iteration-do(False); }

      $_widget.emit-by-name(
        'signal',
      #  'any-args',
      #  :return-type(int32),
      #  :parameters([int32,])
      );
      is $!signal-processed, True, ''…' signal processed';

      while $main.gtk-events-pending() { $main.iteration-do(False); }

      #$!signal-processed = False;
      #$_widget.emit-by-name(
      #  'signal',
      #  'any-args',
      #  :return-type(int32),
      #  :parameters([int32,])
      #);
      #is $!signal-processed, True, ''…' signal processed';

      while $main.gtk-events-pending() { $main.iteration-do(False); }
      sleep(0.4);
      $main.gtk-main-quit;

      'done'
    }
  }

  my Gnome::Gtk4::AlternativeTrigger $alternativetrigger .= new;

  #my Gnome::Gtk3::Window $w .= new;
  #$w.add($m);

  my SignalHandlers $sh .= new;
  $alternativetrigger.register-signal( $sh, 'method', 'signal');

  my Promise $p = $i.start-thread(
    $sh, 'signal-emitter',
    # :!new-context,
    # :start-time(now + 1)
  );

  is $main.gtk-main-level, 0, "loop level 0";
  $main.gtk-main;
  #is $main.gtk-main-level, 0, "loop level is 0 again";

  is $p.result, 'done', 'emitter finished';
}

