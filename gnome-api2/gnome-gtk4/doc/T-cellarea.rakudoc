=comment Package: Gtk4, C-Source: cellarea
use v6.d;

=begin rakudoc
=TITLE Gnome::Gtk4::T-cellarea
=end rakudoc

#-------------------------------------------------------------------------------
#--[Callback Functions]---------------------------------------------------------
#-------------------------------------------------------------------------------

=begin rakudoc
=head1 Callback Functions
=head2 CellAllocCallback

=head3 Signature
=begin code
:(  N-Object() $renderer, N-Object $cell-area, N-Object $cell-background, gpointer $data  )
=end code

=item $renderer; the cell renderer to operate on
=item $cell-area; the area allocated to C<$renderer> inside the rectangle
  provided to C<.foreach-alloc()>.
=item $cell-background; the background area for C<$renderer> inside the
  background area provided to C<.foreach-alloc()>.
=item $data; user-supplied data

=head2 CellCallback

=head3 Signature
=begin code
:(  N-Object() $renderer, gpointer $data  )
=end code

=item $renderer; the cell renderer to operate on
=item $data; user-supplied data

=end rakudoc
