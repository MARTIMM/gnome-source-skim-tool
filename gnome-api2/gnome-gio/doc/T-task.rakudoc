=item $task; the B<Gnome::Gio::Task>
=item $source-object; C<$task>'s source object
=item $task-data; C<$task>'s task data
=item $cancellable; C<$task>'s B<Gnome::Gio::Cancellable>, or undefined

=end rakudoc
